# ============================================================================
# 本地敏感信息模板
#
# 复制成项目根目录的 .env 再填值：
#   PowerShell:  Copy-Item configs\.env.example .env
#   命令行:      copy configs\.env.example .env
#
# .env 在 .gitignore 里，不会被提交。
# 优先级：环境变量 > .env 文件 > config.yaml 里的占位符
#
# ⚠️ 这里的值只写**本机开发**用的，不要写生产账号。
# ============================================================================

# ---------- mall4j 管理后台 ----------
# 登录账号密码（框架会自动过拼图验证码，再把密码 AES 加密后提交）
#
# ⚠️ 密码是**必须的** —— 不填的话登录接口会因为空密码被服务端拒掉。
MALL4J_USERNAME=
MALL4J_PASSWORD=

# 会话标识 uuid（只有"靠 uuid 维持会话"的系统才需要，当前项目不用）
MALL4J_UUID=

# 测试环境地址（不填就用 config.yaml 里的默认值）
MALL4J_TEST_HOST=
MALL4J_TEST_WEB_URL=
MALL4J_PRE_HOST=
MALL4J_PRE_WEB_URL=

# ---------- 演示项目（adapters/demo.py）----------
# 第二个系统的演示账号，默认值是假的，填真实账号前先确认
DEMO_USERNAME=
DEMO_PASSWORD=

# ---------- 数据库校验 ----------
# config.yaml 里 db.default 用的密码
DB_PASSWORD=

# mall4j 业务库（用例里的查库断言，alias: mall4j）
# 这四项不填，用到查库断言的用例会直接报"配置不完整"，
# 而不是悄悄跳过 —— 免得以为验了、其实没验。
MALL4J_DB_HOST=
MALL4J_DB_PORT=3306
MALL4J_DB_USER=
MALL4J_DB_PASSWORD=
MALL4J_DB_NAME=

# ---------- 缓存校验 ----------
REDIS_PASSWORD=

# ---------- 消息队列校验 ----------
MQ_PASSWORD=

# ---------- AI 功能（可选）----------
# 不填就用本地规则，不影响用例执行
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
