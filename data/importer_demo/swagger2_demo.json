{
  "swagger": "2.0",
  "info": { "title": "旧版 Swagger 例子", "version": "1.0" },
  "host": "admin-api.pickmall.cn",
  "basePath": "/manager",
  "schemes": ["https"],
  "paths": {
    "/statistics/order": {
      "get": {
        "tags": ["statistics"],
        "summary": "订单统计（旧版）",
        "parameters": [
          {
            "name": "searchType", "in": "query", "required": true, "type": "string",
            "enum": ["LAST_SEVEN"]
          },
          { "name": "pageSize", "in": "query", "type": "integer", "default": 10 }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": { "$ref": "#/definitions/OrderStat" }
          }
        }
      }
    },
    "/order/create": {
      "post": {
        "tags": ["order"],
        "summary": "创建订单（旧版）",
        "parameters": [
          {
            "name": "body", "in": "body", "required": true,
            "schema": { "$ref": "#/definitions/CreateOrder" }
          }
        ],
        "responses": { "200": { "description": "OK" } }
      }
    }
  },
  "definitions": {
    "OrderStat": {
      "type": "object",
      "properties": {
        "code": { "type": "integer", "example": 200 },
        "success": { "type": "boolean", "example": true },
        "result": {
          "type": "object",
          "properties": {
            "total": { "type": "integer" },
            "amount": { "type": "number" }
          }
        }
      }
    },
    "CreateOrder": {
      "type": "object",
      "required": ["goodsId"],
      "properties": {
        "goodsId": { "type": "integer", "example": 1001 },
        "quantity": { "type": "integer", "example": 2 },
        "remark": { "type": "string" }
      }
    }
  }
}
